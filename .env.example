# Copy to .env.local for local `vercel dev`. In production, set these in
# the Vercel dashboard: Project Settings -> Environment Variables.
# Never commit the real values.

# From the Paystack dashboard (Settings -> API Keys & Webhooks).
# Use the TEST keys until you're ready to take real payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Currently Neon (not Supabase — the project started on Neon via the old
# Vercel Postgres/Neon Marketplace integration, and stayed there by
# decision rather than switching). If this ever does move to Supabase, use
# its "Transaction pooler" connection string, not "Direct connection" —
# serverless functions need the pooler (see the comment in api/_lib/db.js).
DATABASE_URL=postgres://neondb_owner:[YOUR-PASSWORD]@ep-xxxx-xxxx-pooler.xx-xxxx-x.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# From resend.com/api-keys. hotelmedallion.com is verified at
# resend.com/domains (confirmed via a real test send, 2026-09-03), so
# RESEND_FROM_EMAIL below can deliver to any recipient. If you ever swap
# to an unverified domain/key, Resend falls back to only delivering to the
# account's own email address -- confirmed by testing, not assumed, the
# hard way (a real guest booking silently got a 403 before this was set up).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Hotel Medallion <reservation@hotelmedallion.com>

# Used to build an absolute URL for the logo image embedded in confirmation
# emails (email clients can't resolve a relative path). Update once this
# site is live on its real domain instead of the Vercel one.
SITE_URL=https://hotel-med.vercel.app

# From aistudio.google.com/apikey. Powers Vesper, the AI concierge chat
# widget (api/chat.js, api/_lib/gemini.js).
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
