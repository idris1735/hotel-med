# Copy to .env.local for local `vercel dev`. In production, set these in
# the Vercel dashboard: Project Settings -> Environment Variables.
# Never commit the real values.

# From the Paystack dashboard (Settings -> API Keys & Webhooks).
# Use the TEST keys until you're ready to take real payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From the Supabase dashboard: Project Settings -> Database -> Connection
# string -> "Transaction pooler" tab (NOT "Direct connection" -- serverless
# functions need the pooler, see the comment in api/_lib/db.js for why).
# Set this by hand both locally AND in Vercel's Project Settings ->
# Environment Variables -- unlike the old Vercel Postgres/Neon Marketplace
# setup, Supabase doesn't auto-inject this.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
